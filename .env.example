# Copy to .env locally and supply distinct credentials for your environment.
POSTGRES_PASSWORD=
# Same PostgreSQL instance, three runtime identities. Passwords in URLs are percent-encoded.
POSTGRES_USER=claro
POSTGRES_DB=claro_demo
DATABASE_URL=postgresql://claro:replace-admin-password@postgres:5432/claro_demo
PLATFORM_DATABASE_URL=postgresql://claro_platform_app:replace-platform-password@postgres:5432/claro_demo
CRM_DATABASE_URL=postgresql://claro_crm_app:replace-crm-password@postgres:5432/claro_crm
BILLING_DATABASE_URL=postgresql://claro_billing_app:replace-billing-password@postgres:5432/claro_facturacion
CRM_API_KEY=
BILLING_API_KEY=
SIMULATOR_FAULT_MODE=off
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_TOKEN=
DEMO_MODE=true
DEMO_RETENTION_MAX_PERCENT=35
DEMO_BUSINESS_DATE=2026-11-18
DEMO_HOLDER_CODE=
DEMO_INGRESS_TOKEN=
DEMO_BILLING_CHAT_ID=
DEMO_RETENTION_CHAT_ID=
DEMO_ASSIGNED_CHAT_ID=
DEMO_SUPPORT_CHAT_ID=
DEMO_ASSESSOR_EMAIL=
DEMO_ASSESSOR_PASSWORD=
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=
# Optional separate demo identities; each requires its own credentials.
DEMO_N2_EMAIL=
DEMO_N2_PASSWORD=
DEMO_SUPERVISOR_EMAIL=
DEMO_SUPERVISOR_PASSWORD=
DEMO_SUPERADMIN_EMAIL=
DEMO_SUPERADMIN_PASSWORD=
REDIS_URL=redis://redis:6379
LANGFUSE_BASE_URL=
ML_API_URL=
ML_SERVICE_TOKEN=
ML_RELEASE_VERSION=2
ML_CHURN_BUNDLE_DIR=
AGENT_PROVIDERS=fixtures
OPENAI_API_KEY=
JEV_MODEL=typesafe/jev-1.14
KNOWLEDGE_MCP_URL=
KNOWLEDGE_SERVICE_TOKEN=
OPENROUTER_API_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Local access only. On the VPS use SSH forwards to these loopback ports.
LANGFUSE_UI_URL=http://127.0.0.1:39085
MLFLOW_UI_URL=http://127.0.0.1:39086
MLFLOW_UI_PORT=39086
PROMPT_EVAL_ENABLED=false
PROMPT_EVAL_PROVIDERS=local
PROMPT_EVAL_INPUT_DIR=
KNOWLEDGE_PUBLICATION_DIR=
KNOWLEDGE_ORIGINALS_DIR=
RAG_LAB_LIVE_ENABLED=false

# Private integration MCP service identity and capability signing key (generate independent secrets).
INTEGRATION_MCP_TOKEN=
INTEGRATION_MCP_SIGNING_KEY=
