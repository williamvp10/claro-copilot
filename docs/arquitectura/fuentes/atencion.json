      "id": "asesor",
      "label": "Atención humana"
    },
    {
      "id": "priv",
      "label": "Copiloto privado"
    }
  ],
  "nodes": [
    {
      "id": "chat",
      "lane": "auto",
      "col": 0,
      "type": "external",
      "label": "Cliente escribe",
      "sublabel": "Chat web o Telegram"
    },
    {
      "id": "rag",
      "lane": "auto",
      "col": 1,
      "type": "backend",
      "label": "Agente consulta RAG",
      "sublabel": "Fuente vigente y pública"
    },
    {
      "id": "resp",
      "lane": "auto",
      "col": 2,
